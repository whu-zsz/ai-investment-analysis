# 必填：服务端口
SERVER_PORT=8080

# 必填：外部数据库连接
# 生产环境请填写云数据库或独立 MySQL 实例地址，不要再写 docker service 名
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=replace-with-real-database-password
DB_NAME=stock_analysis

# 必填：JWT
# 必须至少 32 个字符，且不要使用默认弱值
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_EXPIRE_HOURS=24

# 必填：LLM provider，只能填 deepseek 或 doubao
LLM_PROVIDER=deepseek

# 使用 DeepSeek 时必填
DEEPSEEK_API_KEY=replace-with-real-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 使用豆包 / Ark 时必填
DOUBAO_API_KEY=
DOUBAO_API_URL=https://ark.cn-beijing.volces.com
DOUBAO_MODEL=

# 首发建议：关闭市场实时能力，避免 provider 未就绪影响上线
MARKET_ENABLED=false

# 仅当 MARKET_ENABLED=true 时需要
# 可选值：mock、eastmoney、hybrid、tencent
MARKET_PROVIDER=tencent
MARKET_SYMBOLS=000001.SH,399001.SZ,399006.SZ,000300.SH
MARKET_SNAPSHOT_INTERVAL=60
MARKET_TIMEOUT_SECONDS=5
MARKET_EASTMONEY_BASE_URL=https://push2.eastmoney.com/api/qt/ulist.np/get
MARKET_EASTMONEY_USER_AGENT=Mozilla/5.0
MARKET_EASTMONEY_REFERER=https://quote.eastmoney.com/center/gridlist.html

# 上传配置
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=10485760

# 说明：Redis 当前由 docker-compose 提供，但后端代码当前未读取 Redis 环境变量
